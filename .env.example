# copy to .env and fill in

DJANGO_SECRET_KEY=change-me

POSTGRES_DB=hypertube
POSTGRES_USER=hypertube_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# https://www.themoviedb.org/settings/api (used for ratings, cast and director)
TMDB_API_KEY=

# oauth, optional (normal register/login works without)
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_REDIRECT_URI=http://localhost:8000/internal/auth/auth/42/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/internal/auth/auth/github/callback/

# gmail + app password, only needed for password reset emails
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
